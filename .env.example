# Configuración local de ejemplo. Copiar a .env para uso en local.
# No contiene secretos reales.

DB_USER=simulador
DB_PASSWORD=local_db_123
DB_HOST=localhost
DB_PORT=3306
DB_NAME=simulador_bolsa

MYSQL_ROOT_PASSWORD=local_root_123
MYSQL_DATABASE=simulador_bolsa
MYSQL_USER=simulador
MYSQL_PASSWORD=local_db_123

JWT_SECRET_KEY=local-only-change-me-min-32-chars-1234567890
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
APP_ENV=local
INITIAL_BALANCE=50000
VITE_API_BASE_URL=/api
